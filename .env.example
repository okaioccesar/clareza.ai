# Configure only in the Vercel project environment, never in public JS.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4.1-mini

# Public connection values; never use a service-role/secret key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# WhatsApp pilot: server only. Disabled until Meta setup and inbox are ready.
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
# Your authorized test sender, country code + number, digits only.
WHATSAPP_TEST_SENDER=
# Secret/service-role key ONLY for the server inbox. Never expose in /api/config or dist.
SUPABASE_SERVICE_ROLE_KEY=
